# ── VAPID keys for Web Push ──────────────────────────────────────────────────
# Generate these by visiting http://localhost:5000/api/generate-vapid-keys
# when VAPID_PUBLIC_KEY is NOT set (first run only).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to ./course_alert.db (local) or /data/course_alert.db (Docker)
# DATABASE_PATH=./course_alert.db

# ── Server port ───────────────────────────────────────────────────────────────
PORT=5000
